<?xml version="1.0" encoding="utf-8"?>
<!--
   备份/迁移配置（API 31 及以上）：纳入登录态与课表/成绩/考试缓存，排除缓存目录。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>

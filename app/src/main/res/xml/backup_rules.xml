<?xml version="1.0" encoding="utf-8"?>
<!--
   备份配置（API 30 及以下）：
   把登录态（Cookie）与课表/成绩/考试缓存（SharedPreferences）以及内部文件纳入备份，
   这样卸载重装 / 换机时能恢复，减少重复登录。排除缓存目录。
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="file" path="cache/" />
</full-backup-content>
